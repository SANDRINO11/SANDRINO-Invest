const prisma = new PrismaClient();

async function getMemberData(userId: string) {
  const user = await prisma.user.findUnique({
    where: { id: userId },
    include: {
      wallet: true,
      subscriptions: {
        where: { status: 'ACTIVE' },
        orderBy: { createdAt: 'desc' },
        take: 1,
      },
      submissions: {
        include: { mission: true },
        orderBy: { createdAt: 'desc' },
        take: 5,
      },
    },
  });

  const availableMissionsCount = await prisma.mission.count({
    where: { isActive: true },
  });

  return { user, availableMissionsCount };
}

