                  {wallet?.totalEarned ? Number(wallet.totalEarned).toLocaleString('fr-FR') : '0'}{' '}
                  <span className="text-slate-400 text-lg">FCFA</span>
                </h3>
              </div>
              <div className="p-3 bg-blue-500/10 text-blue-400 rounded-xl">
                <Award className="w-6 h-6" />
              </div>
            </div>
            <p className="text-xs text-slate-400 mt-4">Cumul vérifié des missions approuvées</p>
          </div>

          <div className="p-6 bg-slate-900 border border-slate-800 rounded-2xl">
            <div className="flex justify-between items-start">
              <div>
                <p className="text-sm font-medium text-slate-400">Missions disponibles</p>
                <h3 className="text-3xl font-extrabold text-white mt-2">{availableMissionsCount}</h3>
              </div>
              <div className="p-3 bg-purple-500/10 text-purple-400 rounded-xl">
                <CheckCircle className="w-6 h-6" />
              </div>
            </div>
            <div className="mt-4">
              <Link
                href="/dashboard/missions"
                className="inline-flex items-center gap-1 text-sm font-semibold text-purple-400 hover:text-purple-300"
              >
                Explorer le catalogue <ArrowUpRight className="w-4 h-4" />
              </Link>
            </div>
          </div>
        </div>

        {/* Dernières activités */}
        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6">
          <h2 className="text-lg font-bold text-white mb-4">Activités récentes</h2>
          <div className="divide-y divide-slate-800">
            {user?.submissions && user.submissions.length > 0 ? (
              user.submissions.map((sub) => (
                <div key={sub.id} className="py-4 flex items-center justify-between">
                  <div>
                    <p className="font-semibold text-white">{sub.mission.title}</p>
                    <p className="text-xs text-slate-400">
                      Rémunération promise : {Number(sub.mission.rewardPerUser).toLocaleString('fr-FR')} FCFA
                    </p>
                  </div>
                  <span
                    className={`px-3 py-1 rounded-full text-xs font-bold ${
                      sub.status === 'APPROVED'
                        ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                        : sub.status === 'REJECTED'
                        ? 'bg-red-500/10 text-red-400 border border-red-500/20'
                        : 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                    }`}
                  >
                    {sub.status}
                  </span>
                </div>
              ))
            ) : (
              <p className="text-slate-500 text-sm py-4">Aucune mission accomplie pour le moment.</p>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
